# Copy this file to .env and fill in values.
# .env is gitignored; .env.example is committed.
#
# LLM access (Phase 2). OpenRouter is OpenAI-compatible.
# The key is read by the code from the environment variable named here.
OPENROUTER_API_KEY=

# Postgres container (staging database for the DDDS snapshot; see docs/DATA.md)
POSTGRES_USER=elexai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=elexai
POSTGRES_PORT=5432

# Neo4j (variant D graph; works with Neo4j Desktop or the optional docker service)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
